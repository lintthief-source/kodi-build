<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.silvolists" name="Silvo Lists" version="1.0.1" provider-name="lintthief">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="plugin.video.themoviedb.helper"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Poster-collage tiles for your Trakt lists</summary>
    <description lang="en_GB">Lists every Trakt list as a tile with poster-collage artwork. Selecting a tile opens the list through TMDb Helper.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
