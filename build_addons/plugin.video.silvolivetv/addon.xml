<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.silvolivetv" name="Silvo Live TV" version="1.0.1" provider-name="lintthief">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">One list of every live TV add-on</summary>
    <description lang="en_GB">Lists the IPTV Simple Client (PVR) and the live TV / sports add-ons that are installed, with their own artwork.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
