<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.silvobuild" name="Silvo Build Wizard" version="1.0.0" provider-name="lintthief">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.requests"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">One-click installer for the Aeon Nox SiLVO + Trakt build</summary>
    <description lang="en_GB">Downloads and installs the Silvo build (skin, menus, widgets, Trakt lists and screenshot folder) on any Kodi 21 device.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
